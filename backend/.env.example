APP_NAME=SampleCap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database MAC
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=8889
DB_DATABASE=samplecap
DB_USERNAME=root
DB_PASSWORD=root
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# FFmpeg must include libass (>= 0.17) to burn captions into MP4.
# macOS: brew install ffmpeg-full -> /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg   Linux: apt install ffmpeg
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Optional: dedicated queue for MP4 renders (run: php artisan queue:work --queue=renders,default)
RENDER_QUEUE=default
RENDER_TIMEOUT=3600
# Private disk for exported files (downloads use signed URLs)
EXPORT_DISK=local
EXPORT_DOWNLOAD_TTL=30
