# ---------------------------------------------------------------------------
# SampleCap API — copy to .env and fill in. Never commit .env.
# Full reference: ../docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------

APP_NAME=SampleCap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The React app's origin(s). Used for CORS.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"
# Load balancer/reverse proxy IPs to trust for X-Forwarded-* headers (or *)
TRUSTED_PROXIES=

# --- Branding (one place; Unicode allowed, e.g. පේළිCap) -------------------
BRAND_NAME="${APP_NAME}"
BRAND_SHORT_NAME=
BRAND_LOGO_TEXT=
BRAND_TAGLINE="AI-powered video captions"
BRAND_DESCRIPTION="Create, edit and export captions with AI."
BRAND_SUPPORT_EMAIL=support@example.com

# --- Database (MySQL 8 / MariaDB 10.6+ / PostgreSQL 14+, utf8mb4) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=samplecap
DB_USERNAME=
DB_PASSWORD=
# MAMP on macOS: DB_PORT=8889 and DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
DB_SOCKET=

# --- Redis (queues, cache, rate limits, Horizon) ----------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev can use "database"; production should use "redis".
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=array

# --- Queues / Horizon -------------------------------------------------------
# MP4 renders run on their own queue so they never block AI captioning.
RENDER_QUEUE=renders
RENDER_TIMEOUT=3600
HORIZON_BASIC_AUTH_USER=
HORIZON_BASIC_AUTH_PASSWORD=
HORIZON_PIPELINE_PROCESSES=4
HORIZON_RENDER_PROCESSES=2

# --- Storage (all user media is PRIVATE; clients get signed URLs) -----------
FILESYSTEM_DISK=local
MEDIA_DISK=local
EXPORT_DISK=local
MEDIA_STREAM_TTL=720
EXPORT_DOWNLOAD_TTL=30
UPLOAD_CHUNK_SIZE=5242880
UPLOAD_SESSION_TTL_HOURS=24
# Object storage (set MEDIA_DISK=s3 EXPORT_DISK=s3). Works with S3, Cloudflare R2, MinIO, Spaces.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- AI (Gemini) -------------------------------------------------------------
# Each user adds their own Google AI key in Account & usage (https://aistudio.google.com/app/api-keys).
# GEMINI_API_KEY is the server's key: used only when AI_ALLOW_SERVER_KEY=true (platform pays for AI).
# AI_PROVIDER=fake produces sample captions without any key (development/tests only).
AI_PROVIDER=gemini
AI_ALLOW_SERVER_KEY=false
GEMINI_API_KEY=
# Speech → timed words (Interactions API). Falls back to the text model if unavailable.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Caption clean-up (punctuation/formatting) and fallback transcription.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_CAPTION_CLEANUP=true
GEMINI_DIARIZATION=true
GEMINI_TRANSCRIBE_CHUNK_SECONDS=1500
GEMINI_TIMEOUT=240
# Tried when the main model is overloaded or times out (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-flash-latest
# Model reasoning for transcription: low (fast) | high | default
GEMINI_THINKING=low
# Ask Gemini for per-word timings (slower). false = estimate them from each caption line.
GEMINI_WORD_TIMINGS=false
GEMINI_INLINE_MAX_BYTES=15728640

# --- FFmpeg (must include libass >= 0.17 for MP4 caption burn-in) ------------
# macOS: brew install ffmpeg-full -> /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg   Linux: apt install ffmpeg
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- Plans & usage limits (see config/plans.php) ----------------------------
DEFAULT_PLAN=free
FREE_CAPTION_MINUTES=120
FREE_AI_REQUESTS_PER_DAY=30
FREE_STORAGE_MB=5120
MAX_UPLOAD_MB=500

# --- Auth --------------------------------------------------------------------
# API token lifetime in minutes (30 days). 0 = never expire.
SANCTUM_TOKEN_EXPIRATION=43200
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# Structured JSON events go to storage/logs/events-YYYY-MM-DD.log
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

MAIL_MAILER=log
