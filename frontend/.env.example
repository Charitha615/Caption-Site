# Laravel API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000/api

# Branding — the single place to rename the product in the web app (Unicode allowed, e.g. පේළිCap).
VITE_BRAND_NAME=SampleCap
VITE_BRAND_TAGLINE="AI-powered video captions"
VITE_BRAND_DESCRIPTION="Create, edit and export captions with AI."
VITE_BRAND_SUPPORT_EMAIL=support@example.com

# Show the demo-account shortcut on the login page (development only).
VITE_SHOW_DEMO_LOGIN=true
