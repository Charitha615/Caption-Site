# Laravel API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000/api

# Branding — the single place to rename the product in the web app (Unicode allowed, e.g. පේළිCap).
VITE_BRAND_NAME=Sinsub
VITE_BRAND_LOGO_TEXT="සිංසබ්.lk"
VITE_BRAND_DOMAIN=sinsub.lk
# Public address of the site (canonical URLs, sitemap, share tags). Other domains redirect here.
VITE_SITE_URL=https://sinsub.lk
VITE_BRAND_TAGLINE="Sinhala & English video captions"
VITE_BRAND_DESCRIPTION="Create, edit and export Sinhala and English captions for your videos."
VITE_BRAND_SUPPORT_EMAIL=support@sinsub.lk

# Show the demo-account shortcut on the login page (development only).
VITE_SHOW_DEMO_LOGIN=true

# "Continue with Google": OAuth 2.0 Web client ID from Google Cloud Console (leave empty to hide errors until set up)
VITE_GOOGLE_CLIENT_ID=

# Optional photo behind the sign-in panel (path in public/ or a URL). Empty = built-in artwork.
VITE_AUTH_WALLPAPER=
